# AI-Powered Project Report Reviewer
# Environment Configuration

# Application Settings
APP_NAME="AI-Powered Project Report Reviewer"
APP_VERSION="1.0.0"
DEBUG=false

# JWT Authentication
# Change this to a secure random string in production
SECRET_KEY=your-secret-key-change-in-production-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3

# For custom OpenAI-compatible APIs (e.g., Azure, local models)
# OPENAI_BASE_URL=https://your-custom-api-endpoint/v1

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,txt

# Demo Mode
# Set to true to run without an OpenAI API key (simulated responses)
DEMO_MODE=false

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
