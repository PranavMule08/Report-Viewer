# AI-Powered Project Report Reviewer - Demo Configuration

# Application Settings
APP_NAME="AI-Powered Project Report Reviewer"
APP_VERSION="1.0.0"
DEBUG=true

# JWT Authentication
SECRET_KEY=demo-secret-key-for-development-only-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI API Configuration (not set for demo mode)
# OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=["pdf", "docx", "txt"]

# Demo Mode - Enabled for development without API key
DEMO_MODE=true

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
